<Project Sdk="Microsoft.NET.Sdk">
  <!-- Sample: a plain Avalonia 12 desktop host (Motif's shape). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SIL.TextEditing.Samples.Host10</RootNamespace>
    <IsPackable>false</IsPackable>
    <AvaloniaSkipXamlCompilerValidation>true</AvaloniaSkipXamlCompilerValidation>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <ProjectReference Include="..\..\src\SIL.TextEditing.Avalonia\SIL.TextEditing.Avalonia.csproj" />
    <Compile Include="..\Common\SampleUi.cs" Link="SampleUi.cs" />
  </ItemGroup>
</Project>
