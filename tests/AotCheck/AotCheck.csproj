<Project Sdk="Microsoft.NET.Sdk">
  <!-- Not in the solution. CI runs: dotnet publish tests/AotCheck -r win-x64
       Warnings are errors, so any trim or AOT warning in the two libraries fails the publish. Both are rooted whole,
       so the analyzer sees all their code, not only what Program uses. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <ProjectReference Include="..\..\src\SIL.TextEditing\SIL.TextEditing.csproj" />
    <ProjectReference Include="..\..\src\SIL.TextEditing.Avalonia\SIL.TextEditing.Avalonia.csproj" />
    <TrimmerRootAssembly Include="SIL.TextEditing" />
    <TrimmerRootAssembly Include="SIL.TextEditing.Avalonia" />
  </ItemGroup>
</Project>
